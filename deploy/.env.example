# =============================================================================
# Telos 生产环境变量模板
# -----------------------------------------------------------------------------
# 使用方法:
#   1. 服务器上 cp deploy/.env.example .env
#   2. 按需修改下面的值 (标 [必填] 的必须填)
#   3. chmod 600 .env
#   4. 此文件绝不提交到 git
# =============================================================================

# ---------------------------------------------------------------------------
# 镜像配置
# ---------------------------------------------------------------------------
IMAGE_TAG=latest
IMAGE_OWNER=indulgeback
# GitHub PAT, 需要 read:packages 权限 (私有镜像才需要)
GHCR_USER=indulgeback
GHCR_TOKEN=

# ---------------------------------------------------------------------------
# PostgreSQL 数据库 [必填]
# ---------------------------------------------------------------------------
POSTGRES_DB=telos
POSTGRES_USER=telos
# ⚠️ 强密码, 生成: openssl rand -base64 24
POSTGRES_PASSWORD=
# 调试用: 设为 5432 即对外暴露 (留空=不对外)
EXPOSE_DB_PORT=

# ---------------------------------------------------------------------------
# Consul (服务注册中心 UI/API) - 调试用, 留空=不对外暴露 8500
# ---------------------------------------------------------------------------
CONSUL_UI_PORT=

# ---------------------------------------------------------------------------
# 服务端口 (宿主机映射)
# ---------------------------------------------------------------------------
WEB_PORT=8800
API_GATEWAY_PORT=8890
AGENT_SERVICE_PORT=8895
ADMIN_PORT=8082

# ---------------------------------------------------------------------------
# Admin 后台鉴权 [必填]
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
# ⚠️ 必填! 管理后台登录密码
ADMIN_PASSWORD=
# ⚠️ 必填! Session 加密密钥, 生成: openssl rand -hex 32
ADMIN_SESSION_KEY=
ADMIN_SESSION_TTL=86400
ADMIN_CORS_ORIGINS=https://admin.telos.indulgeback.icu

# ---------------------------------------------------------------------------
# Better-Auth (Web 认证) [必填]
# ---------------------------------------------------------------------------
# ⚠️ 生成: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Web 对外完整 URL (浏览器访问地址, 含协议)
BETTER_AUTH_URL=https://telos.indulgeback.icu
NEXT_PUBLIC_BETTER_AUTH_URL=https://telos.indulgeback.icu
TRUSTED_ORIGINS=https://telos.indulgeback.icu

# ---------------------------------------------------------------------------
# 前端访问 API 的地址 (浏览器侧调用, 必须是公网可达的) [必填]
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.telos.indulgeback.icu
# Agent 返回给浏览器的工作区文件下载链接前缀，通常与公网 API 地址一致。
WORKSPACE_SHARE_BASE_URL=https://api.telos.indulgeback.icu
WORKSPACE_SHARE_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# 网关内部通信密钥 [必填]
# ---------------------------------------------------------------------------
# 生成: openssl rand -hex 32
GATEWAY_INTERNAL_SECRET=
# 建议与网关密钥分离；留空时服务会回退到 GATEWAY_INTERNAL_SECRET。
AGENT_STATE_SIGNING_SECRET=
AUTH_CACHE_TTL_SECONDS=60
AUTH_CLOCK_SKEW_SECONDS=300
GATEWAY_NONCE_TTL_SECONDS=600
GATEWAY_NONCE_KEY_PREFIX=telos:gateway:nonce
GATEWAY_SIGNATURE_BODY_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# Agent 服务 - 是否允许匿名 Owner
# ---------------------------------------------------------------------------
ALLOW_ANONYMOUS_OWNER=false
AGENT_ADMIN_USER_IDS=
ENABLE_BUILTIN_RUN_COMMAND=false
SANDBOX_ENABLED=false
ALLOW_SENSITIVE_TRACING=false
AGENT_RUN_WORKER_CONCURRENCY=2
AGENT_RUN_LEASE_MS=30000
AGENT_RUN_TIMEOUT_MS=900000
AGENT_RUN_MAX_INPUT_BYTES=524288
AGENT_RUN_MAX_OUTPUT_CHARACTERS=262144
AGENT_RUN_MAX_TOOL_CALLS=64
AGENT_RUN_MAX_OUTPUT_TOKENS=16384
# 可选：启用费用上限时必须同时提供对应模型价格 JSON。
AGENT_RUN_MAX_ESTIMATED_COST_USD=
AGENT_MODEL_PRICING_JSON=
AGENT_TOOL_APPROVAL_TTL_MS=900000

# ---------------------------------------------------------------------------
# LLM 提供商 (按需配置, 至少填一个才能用 Agent)
# ---------------------------------------------------------------------------
DEFAULT_AGENT_MODEL=google/gemini-3.1-pro-preview

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 火山方舟 (Seed / 字节)
SEED_API_KEY=
SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 阿里百炼
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI 兼容
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ShortApi
SHORTAPI_API_KEY=
SHORTAPI_BASE_URL=https://api.shortapi.ai/v1

# Gemini
GEMINI_API_KEY=

# Embedding
EMBEDDING_PROVIDER=gcloud
EMBEDDING_MODEL=text-multilingual-embedding-002

# ---------------------------------------------------------------------------
# 腾讯云 COS (图片/文件上传)
# ---------------------------------------------------------------------------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing
COS_PREFIX=chat-images

# ---------------------------------------------------------------------------
# 火山引擎实时语音 (可选)
# ---------------------------------------------------------------------------
VOLC_REALTIME_APP_ID=
VOLC_REALTIME_ACCESS_KEY=
VOLC_REALTIME_APP_KEY=
VOLC_REALTIME_ENDPOINT=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
VOLC_REALTIME_RESOURCE_ID=volc.speech.dialog
VOLC_REALTIME_MODEL=1.2.1.1
VOLC_REALTIME_SPEAKER=zh_female_vv_jupiter_bigtts

# ---------------------------------------------------------------------------
# OAuth 登录 (可选, 不填则不启用)
# ---------------------------------------------------------------------------
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 邮件 (Resend, 可选)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
