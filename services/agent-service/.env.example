# 数据库配置
DATABASE_URL="postgresql://user:password@localhost:5432/telos"
REDIS_URL="redis://localhost:6379"

# DeepSeek API 配置
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# 字节 Seed 配置
# SEED_API_KEY="xxxxxxxxxxxxxx"
# SEED_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# 阿里百炼（DashScope OpenAI 兼容）配置
# BAILIAN_API_KEY="sk-xxxxxxxxxxxxxx"
# BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 火山引擎豆包实时语音配置
# 文档: https://www.volcengine.com/docs/6561/1594356?lang=zh
# VOLC_REALTIME_APP_ID="your-app-id"
# VOLC_REALTIME_ACCESS_KEY="your-access-key"
VOLC_REALTIME_ENDPOINT="wss://openspeech.bytedance.com/api/v3/realtime/dialogue"
VOLC_REALTIME_RESOURCE_ID="volc.speech.dialog"
VOLC_REALTIME_APP_KEY="PlgvMymc7f3tQnJ6"
VOLC_REALTIME_MODEL="1.2.1.1"
# Optional TTS speaker. Use a realtime-dialogue compatible speaker id.
# VOLC_REALTIME_SPEAKER="zh_female_vv_jupiter_bigtts"
# VOLC_REALTIME_DEMO=false

# 服务配置
PORT=8895
WORKER_HEALTH_PORT=8896
NODE_ENV="development"
WORKSPACE_PERSISTED_DIR=.persisted-workspaces

# 网关签名与 durable Agents SDK state 完整性
GATEWAY_INTERNAL_SECRET="replace-with-openssl-rand-hex-32"
AGENT_STATE_SIGNING_SECRET="replace-with-a-separate-openssl-rand-hex-32"
AUTH_CLOCK_SKEW_SECONDS=300
GATEWAY_NONCE_TTL_SECONDS=600
GATEWAY_NONCE_KEY_PREFIX="telos:gateway:nonce"
GATEWAY_SIGNATURE_BODY_MAX_BYTES=10485760
ALLOW_ANONYMOUS_OWNER=false

# Durable run kernel
AGENT_RUN_WORKER_CONCURRENCY=2
AGENT_RUN_LEASE_MS=30000
WORKER_SHUTDOWN_TIMEOUT_MS=120000
WORKER_STOP_GRACE_PERIOD=150s
AGENT_RUN_TIMEOUT_MS=900000
AGENT_RUN_MAX_INPUT_BYTES=524288
AGENT_RUN_MAX_OUTPUT_CHARACTERS=262144
AGENT_RUN_MAX_TOOL_CALLS=64
AGENT_RUN_MAX_OUTPUT_TOKENS=16384
AGENT_TOOL_APPROVAL_TTL_MS=900000

# 日志配置
LOG_LEVEL="info"
