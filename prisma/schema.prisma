// Monorepo Prisma Schema
// 合并了 web (Better-Auth) 和 agent-service 的数据模型

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ============================================================
// Better-Auth Models (来自 apps/web)
// ============================================================

model user {
  id            String   @id @default(cuid())
  email         String?  @unique
  emailVerified Boolean? @default(false)
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts account[]
  sessions session[]

  defaultAgentId String? @map("default_agent_id")
  defaultAgent   Agent?  @relation("UserDefaultAgent", fields: [defaultAgentId], references: [id], onDelete: SetNull)
}

model account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ============================================================
// Agent Service Models (来自 services/agent-service-ts)
// ============================================================

model Agent {
  id                String        @id @default(uuid())
  name              String        @unique
  description       String
  instructions      String        @default("")
  type              AgentType     @default(public)
  modelKey          String        @default("deepseek-v4-flash") @map("model_key")
  temperature       Float         @default(0.7)
  maxTurns          Int           @default(50) @map("max_turns")
  loopMode          AgentLoopMode @default(auto) @map("loop_mode")
  status            AgentStatus   @default(active)
  ownerId           String?       @map("owner_id")
  metadata          Json          @default("{}")
  isDefault         Boolean       @default(false) @map("is_default")
  instructionStatus String        @default("pending") @map("instruction_status")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  skillsAsAgent     AgentSkill[]     @relation("AgentSkills")
  toolsAsAgent      AgentTool[]      @relation("AgentTools")
  mcpServersAsAgent AgentMcpServer[] @relation("AgentMcpServers")
  subagentsAsParent AgentRelation[]  @relation("ParentAgentRelations")
  parentsAsSubagent AgentRelation[]  @relation("SubagentAgentRelations")
  memories          AgentMemory[]
  threads           AgentThread[]
  runs              AgentRun[]
  defaultUsers      user[]           @relation("UserDefaultAgent")

  @@map("agents")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  description String
  content     String
  enabled     Boolean  @default(true)
  metadata    Json     @default("{}")
  ownerId     String?  @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agents AgentSkill[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("skills")
}

model AgentSkill {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  skillId   String   @map("skill_id")
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent Agent @relation("AgentSkills", fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@map("agent_skills")
}

model Tool {
  id                String   @id
  name              String   @unique
  type              ToolType @default(invokable)
  displayName       String   @map("display_name")
  description       String
  category          String
  endpoint          Json
  parameters        Json
  responseTransform Json     @default("{}") @map("response_transform")
  rateLimit         Json?    @map("rate_limit")
  enabled           Boolean  @default(true)
  version           String   @default("1.0.0")
  tags              Json     @default("[]")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agents AgentTool[]

  @@map("tools")
}

model AgentTool {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  toolId    String   @map("tool_id")
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent Agent @relation("AgentTools", fields: [agentId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@map("agent_tools")
}

model McpServer {
  id                String            @id @default(uuid())
  name              String            @unique
  description       String
  transport         McpTransport
  command           String?
  args              Json              @default("[]")
  url               String?
  env               Json              @default("{}")
  allowedTools      Json              @default("[]") @map("allowed_tools")
  sensitiveTools    Json              @default("[]") @map("sensitive_tools")
  approvalPolicy    McpApprovalPolicy @default(none) @map("approval_policy")
  enabled           Boolean           @default(true)
  metadata          Json              @default("{}")
  lastToolsSnapshot Json              @default("[]") @map("last_tools_snapshot")
  lastConnectedAt   DateTime?         @map("last_connected_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  agents AgentMcpServer[]

  @@map("mcp_servers")
}

model AgentMcpServer {
  id           String   @id @default(uuid())
  agentId      String   @map("agent_id")
  mcpServerId  String   @map("mcp_server_id")
  enabled      Boolean  @default(true)
  allowedTools Json     @default("[]") @map("allowed_tools")
  config       Json     @default("{}")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agent     Agent     @relation("AgentMcpServers", fields: [agentId], references: [id], onDelete: Cascade)
  mcpServer McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@unique([agentId, mcpServerId])
  @@map("agent_mcp_servers")
}

model AgentRelation {
  id          String            @id @default(uuid())
  parentId    String            @map("parent_id")
  subagentId  String            @map("subagent_id")
  mode        AgentRelationMode @default(as_tool)
  name        String?
  description String
  enabled     Boolean           @default(true)
  sortOrder   Int               @default(0) @map("sort_order")
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  parent   Agent @relation("ParentAgentRelations", fields: [parentId], references: [id], onDelete: Cascade)
  subagent Agent @relation("SubagentAgentRelations", fields: [subagentId], references: [id], onDelete: Cascade)

  @@unique([parentId, subagentId, mode])
  @@map("agent_relations")
}

model AgentThread {
  id            String            @id @default(uuid())
  agentId       String            @map("agent_id")
  ownerId       String?           @map("owner_id")
  title         String
  status        AgentThreadStatus @default(active)
  summary       String?
  metadata      Json              @default("{}")
  lastMessageAt DateTime?         @map("last_message_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  agent    Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages AgentMessage[]
  runs     AgentRun[]

  @@index([agentId, ownerId, status, lastMessageAt])
  @@map("agent_threads")
}

model AgentMessage {
  id        String           @id @default(uuid())
  threadId  String           @map("thread_id")
  runId     String?          @map("run_id")
  role      AgentMessageRole
  content   String
  parts     Json             @default("[]")
  metadata  Json             @default("{}")
  sequence  Int
  createdAt DateTime         @default(now()) @map("created_at")

  thread AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  run    AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([threadId, sequence])
  @@index([threadId, createdAt])
  @@index([runId])
  @@map("agent_messages")
}

model AgentMemory {
  id        String                       @id @default(uuid())
  agentId   String                       @map("agent_id")
  ownerId   String                       @map("owner_id")
  content   String                       @default("")
  category  String                       @default("general") // "user_preference" | "task_history" | "domain_fact"
  embedding Unsupported("vector(1536)")?
  metadata  Json                         @default("{}")
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, ownerId])
  @@map("agent_memories")
}

model AgentRun {
  id             String         @id @default(uuid())
  agentId        String         @map("agent_id")
  threadId       String?        @map("thread_id")
  status         AgentRunStatus @default(queued)
  input          Json
  finalOutput    String?        @map("final_output")
  lastAgentName  String?        @map("last_agent_name")
  lastResponseId String?        @map("last_response_id")
  error          String?
  metadata       Json           @default("{}")
  sdkState       String?        @map("sdk_state") @db.Text
  sdkStateHash   String?        @map("sdk_state_hash")
  stateVersion   Int            @default(0) @map("state_version")
  partialOutput  String?        @map("partial_output") @db.Text
  partialParts   Json           @default("[]") @map("partial_parts")
  startedAt      DateTime       @default(now()) @map("started_at")
  completedAt    DateTime?      @map("completed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  agent     Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  thread    AgentThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  messages  AgentMessage[]
  steps     AgentRunStep[]
  events    AgentRunEvent[]
  attempts  AgentRunAttempt[]
  toolCalls AgentToolCall[]
  approvals AgentToolApproval[]

  @@index([agentId, createdAt])
  @@index([threadId])
  @@map("agent_runs")
}

model AgentRunStep {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  attemptId String?  @map("attempt_id")
  index     Int
  agentName String   @map("agent_name")
  type      String
  input     Json?
  output    Json?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  run     AgentRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt AgentRunAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([runId, index])
  @@index([attemptId])
  @@map("agent_run_steps")
}

model AgentRunEvent {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  sequence  Int
  type      String
  agentName String?  @map("agent_name")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, sequence])
  @@map("agent_run_events")
}

// Durable execution ownership. A run may have multiple attempts, but only
// the attempt holding the current lease/fence may write execution results.
model AgentRunAttempt {
  id             String    @id @default(uuid())
  runId          String    @map("run_id")
  attempt        Int
  workerId       String    @map("worker_id")
  leaseToken     String    @unique @map("lease_token")
  fenceToken     Int       @map("fence_token")
  status         String    @default("running")
  leaseExpiresAt DateTime  @map("lease_expires_at")
  heartbeatAt    DateTime  @default(now()) @map("heartbeat_at")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  run       AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  steps     AgentRunStep[]
  toolCalls AgentToolCall[]

  @@unique([runId, attempt])
  @@index([runId, status])
  @@index([status, leaseExpiresAt])
  @@map("agent_run_attempts")
}

// A durable tool execution ledger. idempotencyKey is stable for one logical
// tool invocation and prevents replayed workers from repeating side effects.
model AgentToolCall {
  id             String    @id @default(uuid())
  runId          String    @map("run_id")
  attemptId      String    @map("attempt_id")
  callId         String    @map("call_id")
  toolName       String    @map("tool_name")
  argumentsHash  String    @map("arguments_hash")
  arguments      Json
  idempotencyKey String    @unique @map("idempotency_key")
  status         String    @default("prepared")
  sideEffect     Boolean   @default(false) @map("side_effect")
  result         Json?
  error          String?
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  run      AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt  AgentRunAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  approval AgentToolApproval?

  @@unique([runId, callId])
  @@index([runId, status])
  @@index([attemptId, status])
  @@map("agent_tool_calls")
}

// Human approval is durable and owner-bound. The SDK may suspend/resume a
// run, but approval authority remains in this database record.
model AgentToolApproval {
  id            String    @id @default(uuid())
  runId         String    @map("run_id")
  toolCallId    String    @unique @map("tool_call_id")
  ownerId       String    @map("owner_id")
  toolName      String    @map("tool_name")
  argumentsHash String    @map("arguments_hash")
  status        String    @default("pending")
  expiresAt     DateTime  @map("expires_at")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  run      AgentRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCall AgentToolCall @relation(fields: [toolCallId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([runId, status])
  @@index([status, expiresAt])
  @@map("agent_tool_approvals")
}

// Transactional outbox for durable wakeups/projections. Consumers must claim
// by status + availableAt and acknowledge with the event id.
model AgentOutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  dedupeKey     String    @unique @map("dedupe_key")
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  lockedAt      DateTime? @map("locked_at")
  lockToken     String?   @map("lock_token")
  publishedAt   DateTime? @map("published_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("agent_outbox_events")
}

model ChatModel {
  id                      String            @id @default(uuid())
  modelKey                String            @unique @map("model_key")
  displayName             String            @map("display_name")
  provider                ChatModelProvider
  isReasoning             Boolean           @default(false) @map("is_reasoning")
  isEnabled               Boolean           @default(true) @map("is_enabled")
  sortOrder               Int               @default(0) @map("sort_order")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  supportVision           Boolean           @default(false) @map("support_vision")
  supportReasoningControl Boolean           @default(false) @map("support_reasoning_control")

  @@map("chat_models")
}

enum AgentType {
  public
  private
  system
}

enum AgentLoopMode {
  auto
  single_turn
}

enum AgentStatus {
  active
  archived
  disabled
}

enum ToolType {
  invokable
  streamable
}

enum McpTransport {
  stdio
  streamable_http
  sse
}

enum McpApprovalPolicy {
  none
  all
  sensitive
}

enum AgentRelationMode {
  as_tool
  handoff
}

enum AgentRunStatus {
  queued
  running
  awaiting_approval
  completed
  failed
  cancelled
}

enum AgentThreadStatus {
  active
  archived
  deleted
}

enum AgentMessageRole {
  user
  assistant
  tool
  system
}

enum ChatModelProvider {
  deepseek
  seed
  bailian
  gcloud
  openai
  shortapi
}
